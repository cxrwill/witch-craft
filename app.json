{
  "expo": {
    "name": "WitchCraft",
    "slug": "witch-craft",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "witchcraft",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.witchcraft.app",
      "infoPlist": {
        "UIViewControllerBasedStatusBarAppearance": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1A0A2E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.witchcraft.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "name": "WitchCraft - 赛博女巫日记",
      "shortName": "WitchCraft",
      "description": "探寻你的魔法本源，找到属于你的女巫之路",
      "themeColor": "#0D0618",
      "backgroundColor": "#0D0618",
      "startUrl": "/witch-craft/",
      "scope": "/witch-craft/",
      "display": "standalone",
      "orientation": "portrait",
      "lang": "zh-CN"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-splash-screen"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "imageWidth": 200,
      "resizeMode": "contain",
      "backgroundColor": "#1A0A2E"
    }
  }
}
