{
  "framework": null,
  "buildCommand": "npx expo export --platform web && node scripts/postbuild.js",
  "outputDirectory": "dist",
  "devCommand": "npx expo start",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/manifest.json", "destination": "/manifest.json" },
    { "source": "/sw.js", "destination": "/sw.js" },
    { "source": "/favicon.ico", "destination": "/favicon.ico" },
    { "source": "/_expo/(.*)", "destination": "/_expo/$1" },
    { "source": "/((?!_expo|manifest.json|sw.js|favicon.ico).*)", "destination": "/index.html" }
  ]
}
